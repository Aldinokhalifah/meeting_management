PORT=
# ganti databse url dengan databse di server perusahaan
DATABASE_URL=
# ganti jwt secret sesuai kebutuhan
JWT_SECRET=
# ganti jwt expires
JWT_EXPIRES_IN=
# ganti environment pengembangannya
NODE_ENV=
# ganti api key dengan akun milik perusaahan
OPENROUTER_API_KEY=
# ganti url dengan app yang sudah dideploy
APP_URL=
# ganti url dengan ai agent yang sudah dideploy
AGENT_URL=
# ganti model sesuai kebutuhan
OPENROUTER_MODEL=
# ganti api key resend
RESEND_API_KEY=
# ganti domain email
FROM_EMAIL=noreply@yourdomain.com
# WhatsApp (default: Fonnte — https://fonnte.com). Kosongkan token jika tidak memakai WA.
WHATSAPP_API_TOKEN=
# Opsional: endpoint kirim pesan jika bukan Fonnte (POST form: target, message)
# WHATSAPP_API_URL=https://api.fonnte.com/send